# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: se usa para enviar invitaciones. Nunca lo expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Hosts propios de la plataforma (separados por coma). Cualquier otro host se busca
# como dominio personalizado de un conjunto (marca blanca).
HOSTS_PLATAFORMA=localhost,easyhome.vercel.app
